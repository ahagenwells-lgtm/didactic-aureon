# Generate a value with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DATABASE_URL=sqlite:///./investment_platform.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
PRICE_CACHE_SECONDS=30
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running

# Comma-separated allow list. Keep this empty until a frontend origin is known.
CORS_ORIGINS=
